{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learningfundclear",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "triggers": {"crons": ["*/1 * * * *"]},
  "preview_urls": false,
  "vars": {
    "QUANT_API_ORIGIN": "https://treat-eradicate-spendable.ngrok-free.dev"
  },
  "build": {
    "command": "node scripts/build.mjs --cloudflare"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/quant-terminal/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
