{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learningfundclear",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "triggers": {"crons": ["*/1 * * * *"]},
  "preview_urls": false,
  "vars": {
    "QUANT_API_ORIGIN": "https://quant-daemon-a9m2.onrender.com",
    "OPEN_TERMINAL": "true"
  },

  "durable_objects": {
    "bindings": [{ "name": "FYERS_VAULT", "class_name": "FyersVault" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FyersVault"] }
  ],
  "kv_namespaces": [
    { "binding": "ALERTS_KV", "id": "1946f3a2bf8447be9277516ae4ff4b4a" }
  ],
  "build": {
    "command": "node scripts/build.mjs --cloudflare"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/quant-terminal/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
