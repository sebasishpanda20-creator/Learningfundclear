{
  "name": "learningfundclear-private-rebuild",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build":"node scripts/build.mjs","release:build":"node scripts/release/build-release.mjs","release:manifest":"node scripts/release/generate-manifest.mjs","release:validate":"node scripts/release/validate-release.mjs","release:all":"npm run release:build && npm run release:manifest && npm run release:validate",
    "test:pages": "node qa/audit.cjs",
    "test:flows": "node qa/flows.cjs",
    "test:nifty500": "node qa/nifty500-flows.cjs",
    "test:guards": "node .ci/guard-html-checks.mjs && node --test qa/bsm.test.mjs",
    "test:scanner": "node --test qa/scanner-data.test.cjs",
    "test:feeds": "node qa/feed-flows.cjs",
    "test:public-data": "node --test qa/public-data.test.cjs",
    "test:bsm": "node --test qa/bsm.test.mjs",
    "test:crypto": "node qa/crypto-flows.cjs",
    "test:quant-desk": "node qa/quant-desk-flows.cjs",
    "test:daemon-watch": "node --test qa/daemon-watch.test.mjs",
  "test:terminal": "node --test qa/terminal-open.test.mjs",
    "build:cloudflare": "node scripts/build.mjs --cloudflare",
    "check:cloudflare": "wrangler deploy --dry-run --outdir dist/cloudflare-check",
    "deploy:cloudflare": "wrangler deploy"
  },
  "devDependencies": {
    "playwright": "1.51.1",
    "wrangler": "4.149.0"
  }
}
